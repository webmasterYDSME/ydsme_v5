{
  "name": "york-model-engineers",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "supabase:start": "supabase start && node scripts/configure-local-supabase.mjs",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "stripe:configure-local-membership": "node --env-file=.env.local scripts/configure-local-stripe-membership.mjs",
    "test": "npm run test:unit",
    "test:unit": "node tests/run-unit-tests.mjs",
    "test:database": "node tests/run-database-integration.mjs",
    "test:browser": "node tests/run-browser-smoke.mjs",
    "test:membership-journeys": "node tests/run-membership-journeys.mjs",
    "test:stripe-membership": "node --env-file=.env.local tests/run-stripe-membership-journey.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern supabase/.temp --ignore-pattern supabase/.branches",
    "verify": "npm run lint && npm run build && npm run test:unit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "date-fns": "^4.4.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.32.0",
    "next": "^16.3.1",
    "nextjs-toploader": "^3.9.17",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-turnstile": "^1.1.5",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "svix": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "supabase": "^2.115.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
