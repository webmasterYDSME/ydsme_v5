# Application
# Canonical public URL used to build links and validate trusted request origins.
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# Feature flags
# Optional: true shows the Under Review page; unset or false keeps the site open.
MAINTENANCE_MODE=false
# Whether MemberMojo or the website runs membership is not set here. An administrator chooses it at
# Administrator > Membership system, and it starts on MemberMojo.

# Supabase
# Browser-safe URL of the Supabase project API.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe anonymous key used for policy-controlled Supabase requests.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Privileged server-only key that bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Bot protection
# Browser-safe Cloudflare Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITEKEY=
# Server-only Cloudflare Turnstile verification key.
TURNSTILE_SECRET_KEY=

# Rate limiting
# Server-only secret used to derive privacy-preserving rate-limit identifiers.
RATE_LIMIT_SECRET=
# Server-only key used to sign address-level newsletter unsubscribe links.
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Stripe
# Browser-safe Stripe key used to initialize client-side payment flows.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Preferred least-privilege server key for supported Stripe operations.
STRIPE_RESTRICTED_KEY=
# Server-only Stripe key used by operations that require broader access.
STRIPE_SECRET_KEY=
# Signing secret used to verify events from the primary Stripe webhook.
STRIPE_WEBHOOK_SECRET=
# Signing secret used to verify membership Stripe webhook events.
STRIPE_MEMBERSHIP_WEBHOOK_SECRET=

# Email
# Local-only Mailpit endpoint. Delivery uses it only when both the website and Supabase URLs are loopback URLs.
LOCAL_MAILPIT_URL=http://127.0.0.1:55324
# Server-only Resend API key used to send transactional email.
RESEND_API_KEY=
# Signing secret used to verify Resend delivery webhooks.
RESEND_WEBHOOK_SECRET=
# Sender name and address used for booking email.
BOOKINGS_FROM_EMAIL="York Model Engineers <bookings@example.com>"
# Reply-to address used for booking email.
BOOKINGS_REPLY_TO=secretary@yorkmodelengineers.co.uk
# Sender name and address used for workshop email.
WORKSHOPS_FROM_EMAIL="York Model Engineers <workshops@example.com>"
# Sender name and address used for membership email.
MEMBERSHIP_FROM_EMAIL="York Model Engineers <membership@example.com>"
# Reply-to address used for membership email.
MEMBERSHIP_REPLY_TO=treasurer@yorkmodelengineers.co.uk

# Optional AI event-description polishing (server-only; never use NEXT_PUBLIC_).
OPENAI_API_KEY=
OPENAI_EVENT_DESCRIPTION_MODEL=gpt-4.1-mini
